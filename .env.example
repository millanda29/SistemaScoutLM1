# ========================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a '.env' y completa con tus credenciales
# ========================================================

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# Base de datos SQL Server (Desde red infra: sqlserver22_db,1433 o IP del contenedor 172.31.0.7:1433)
ConnectionStrings__DefaultConnection=Server=sqlserver22_db,1433;Database=ScoutInventory;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT Authentication (debe tener al menos 32 caracteres)
Jwt__Key=ChangeThisToAStrongKeyWithAtLeast32CharactersLong!
Jwt__Issuer=ScoutInventory.Api
Jwt__Audience=ScoutInventory.Client

# Configuración SMTP (Envío de correos)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=tu-correo@gmail.com
Smtp__Password=tu-password-de-aplicacion
Smtp__FromAddress=tu-correo@gmail.com
Smtp__FromName=Scout Inventory System

# Credenciales para Semilla de Usuario Administrador Inicial
AdminSeed__UserName=admin
AdminSeed__Email=admin@scoutinventory.com
AdminSeed__Password=ChangeAdminPassword123!
